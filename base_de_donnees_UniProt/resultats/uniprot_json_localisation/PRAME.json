                  },
                  {
                    "evidenceCode": "ECO:0000269",
                    "source": "PubMed",
                    "id": "23460923"
                  }
                ],
                "value": "Associates with chromatin; specifically enriched at transcriptionally active promoters that are also bound by nuclear transcription factor Y (composed of NFYA, NFYB and NFYC) and at enhancers (PubMed:21822215). Recruited to the Golgi apparatus in response to interferon gamma (IFNG) treatment (PubMed:23460923)"
              }
            ]
